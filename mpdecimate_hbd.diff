+static int sad16(const uint16_t *cur, int cur_linesize,
+                 const uint16_t *ref, int ref_linesize)
+{
+    int x, y, d = 0;
+    for (y = 0; y < 8; y++) {
+        const uint16_t *c = cur + y*(cur_linesize>>1);
+        const uint16_t *r = ref + y*(ref_linesize>>1);
+        for (x = 0; x < 8; x++)
+            d += FFABS((int)c[x] - (int)r[x]);
+    }
+    return d;
+}
